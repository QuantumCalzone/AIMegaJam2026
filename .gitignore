# Unreal Engine generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds (archive directory used in CLAUDE.md)
Packaged/
# The cooker rewrites these on every cook. Other files in Build/ are project build settings; keep them.
Build/*/FileOpenOrder/

# Visual Studio / Rider (only relevant if C++ is added later)
.vs/
.idea/
*.sln
*.suo
*.sdf
*.VC.db
*.VC.opendb
*.vsconfig

# Claude Code personal settings and notes
.claude/settings.local.json
CLAUDE.local.md

# Agent status files stay on one machine (see Agents/README.md)
Agents/status/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Local secrets and switches: the Claude API key file and local test switches.
# Never commit these. The example key file is Docs/llm_key.example.json.
Local/

# Relay (Cloudflare Worker): local keys, packages and wrangler's local state.
Relay/.dev.vars*
!Relay/.dev.vars.example
Relay/node_modules/
Relay/.wrangler/
